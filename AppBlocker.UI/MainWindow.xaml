<Window x:Class="AppBlocker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppBlocker.UI.ViewModels"
        xmlns:views="clr-namespace:AppBlocker.UI.Views"
        mc:Ignorable="d"
        Title="AppBlocker - Windows App &amp; Web Guardian"
        Height="780" Width="1180"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMainBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <!-- 1. Authentication Gate (Shown when locked) -->
        <views:LockScreenView DataContext="{Binding LockScreenVM}"
                              Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisConverter}}" />

        <!-- 2. Main Dashboard Interface (Shown when authenticated) -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Branding Header -->
                    <Border Grid.Row="0" Padding="20,24,20,20" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="10" Background="#261E40" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1" Margin="0,0,12,0">
                                <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="APPBLOCKER" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Desktop &amp; Web Control" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Tab Navigation Buttons -->
                    <StackPanel Grid.Row="1" Margin="14,18,14,0">
                        <!-- Apps Tab -->
                        <RadioButton GroupName="NavTabs"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=0, Mode=TwoWay}"
                                     Click="NavButton_Click" Tag="0" Margin="0,0,0,6">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="14,10" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="💻  " FontSize="15" />
                                                        <TextBlock Text="Applications" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" x:Name="txtLabel" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#221C38" />
                                                        <Setter TargetName="txtLabel" Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <!-- Websites Tab -->
                        <RadioButton GroupName="NavTabs"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=1, Mode=TwoWay}"
                                     Click="NavButton_Click" Tag="1" Margin="0,0,0,6">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="14,10" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🌐  " FontSize="15" />
                                                        <TextBlock Text="Websites" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" x:Name="txtLabel" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#172733" />
                                                        <Setter TargetName="txtLabel" Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <!-- Schedules Tab -->
                        <RadioButton GroupName="NavTabs"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=2, Mode=TwoWay}"
                                     Click="NavButton_Click" Tag="2" Margin="0,0,0,6">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="14,10" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⏱️  " FontSize="15" />
                                                        <TextBlock Text="Schedules" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" x:Name="txtLabel" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#221C38" />
                                                        <Setter TargetName="txtLabel" Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <!-- Logs Tab -->
                        <RadioButton GroupName="NavTabs"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=3, Mode=TwoWay}"
                                     Click="NavButton_Click" Tag="3" Margin="0,0,0,6">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="14,10" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📋  " FontSize="15" />
                                                        <TextBlock Text="Audit Logs" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" x:Name="txtLabel" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#221C38" />
                                                        <Setter TargetName="txtLabel" Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <!-- Settings Tab -->
                        <RadioButton GroupName="NavTabs"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=4, Mode=TwoWay}"
                                     Click="NavButton_Click" Tag="4" Margin="0,0,0,6">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="14,10" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="⚙️  " FontSize="15" />
                                                        <TextBlock Text="Settings &amp; Defense" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" x:Name="txtLabel" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#221C38" />
                                                        <Setter TargetName="txtLabel" Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom Sidebar: Service Daemon Status & Lock Action -->
                    <Border Grid.Row="2" Padding="16" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <!-- Service Status Badge -->
                            <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A2D24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                                <Setter Property="Background" Value="#3B1D25" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ServiceStatusBadge}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Width="180">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Lock Dashboard Button -->
                            <Button Content="🔒 Lock Dashboard" Command="{Binding LockCommand}" Style="{StaticResource ModernSecondaryButton}" Height="34" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area with Tab Switching -->
            <Grid Grid.Column="1" Background="{StaticResource BgMainBrush}">
                <!-- Apps Tab (Index 0) -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=0}">
                    <views:AppsView DataContext="{Binding AppsVM}" />
                </Grid>

                <!-- Websites Tab (Index 1) -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=1}">
                    <views:WebsitesView DataContext="{Binding WebsitesVM}" />
                </Grid>

                <!-- Schedules Tab (Index 2) -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=2}">
                    <views:SchedulesView DataContext="{Binding SchedulesVM}" />
                </Grid>

                <!-- Logs Tab (Index 3) -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=3}">
                    <views:LogsView DataContext="{Binding LogsVM}" />
                </Grid>

                <!-- Settings Tab (Index 4) -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=4}">
                    <views:SettingsView DataContext="{Binding SettingsVM}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
