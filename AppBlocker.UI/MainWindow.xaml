<Window x:Class="AppBlocker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppBlocker.UI.ViewModels"
        xmlns:views="clr-namespace:AppBlocker.UI.Views"
        mc:Ignorable="d"
        Title="AppBlocker - Windows App &amp; Web Guardian"
        Height="780" Width="1180"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMainBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <!-- 1. Authentication Gate (Shown when locked) -->
        <views:LockScreenView DataContext="{Binding LockScreenVM}"
                              Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisConverter}}" />

        <!-- 2. Main Dashboard Interface (Shown when authenticated) -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation (Collapsible 260px / 68px) -->
            <Border Grid.Column="0" Width="{Binding SidebarWidth}" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Branding Header with Collapse/Expand Toggle -->
                    <Border Grid.Row="0" Padding="14,20" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="#261E40" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1" Margin="0,0,10,0">
                                    <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <TextBlock Text="APPBLOCKER" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Desktop &amp; Web Control" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Collapse / Expand Toggle Button -->
                            <Button Grid.Column="1" Command="{Binding ToggleSidebarCommand}"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    Padding="0" Height="28" Width="28"
                                    VerticalAlignment="Center"
                                    ToolTip="Toggle Sidebar (Expand / Collapse)">
                                <TextBlock FontSize="10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="◀" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                    <Setter Property="Text" Value="▶" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Tab Navigation Buttons -->
                    <StackPanel Grid.Row="1" Margin="10,18,10,0">
                        <!-- Apps Tab -->
                        <RadioButton GroupName="NavTabs"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=0, Mode=TwoWay}"
                                     Click="NavButton_Click" Tag="0" Margin="0,0,0,6"
                                     ToolTip="Applications Engine">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="12,10" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <TextBlock Text="💻" FontSize="16" Width="24" TextAlignment="Center" />
                                                        <TextBlock Text="Applications" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" x:Name="txtLabel" Margin="10,0,0,0"
                                                                   Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisConverter}}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#221C38" />
                                                        <Setter TargetName="txtLabel" Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <!-- Websites Tab -->
                        <RadioButton GroupName="NavTabs"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=1, Mode=TwoWay}"
                                     Click="NavButton_Click" Tag="1" Margin="0,0,0,6"
                                     ToolTip="Web Filtering Engine">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="12,10" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <TextBlock Text="🌐" FontSize="16" Width="24" TextAlignment="Center" />
                                                        <TextBlock Text="Websites" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" x:Name="txtLabel" Margin="10,0,0,0"
                                                                   Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisConverter}}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#172733" />
                                                        <Setter TargetName="txtLabel" Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <!-- Schedules Tab -->
                        <RadioButton GroupName="NavTabs"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=2, Mode=TwoWay}"
                                     Click="NavButton_Click" Tag="2" Margin="0,0,0,6"
                                     ToolTip="Schedules &amp; Focus Timer">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="12,10" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <TextBlock Text="⏱️" FontSize="16" Width="24" TextAlignment="Center" />
                                                        <TextBlock Text="Schedules" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" x:Name="txtLabel" Margin="10,0,0,0"
                                                                   Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisConverter}}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#221C38" />
                                                        <Setter TargetName="txtLabel" Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <!-- Logs Tab -->
                        <RadioButton GroupName="NavTabs"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=3, Mode=TwoWay}"
                                     Click="NavButton_Click" Tag="3" Margin="0,0,0,6"
                                     ToolTip="Analytics &amp; Audit Logs">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="12,10" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <TextBlock Text="📊" FontSize="16" Width="24" TextAlignment="Center" />
                                                        <TextBlock Text="Analytics &amp; Logs" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" x:Name="txtLabel" Margin="10,0,0,0"
                                                                   Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisConverter}}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#221C38" />
                                                        <Setter TargetName="txtLabel" Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <!-- Settings Tab -->
                        <RadioButton GroupName="NavTabs"
                                     IsChecked="{Binding SelectedTabIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=4, Mode=TwoWay}"
                                     Click="NavButton_Click" Tag="4" Margin="0,0,0,6"
                                     ToolTip="Settings &amp; Defense">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="8" Padding="12,10" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <TextBlock Text="⚙️" FontSize="16" Width="24" TextAlignment="Center" />
                                                        <TextBlock Text="Settings &amp; Defense" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" x:Name="txtLabel" Margin="10,0,0,0"
                                                                   Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisConverter}}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="4">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#221C38" />
                                                        <Setter TargetName="txtLabel" Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom Sidebar: Service Daemon Status & Lock Action -->
                    <Border Grid.Row="2" Padding="12" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <!-- Service Status Badge -->
                            <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,10"
                                    ToolTip="{Binding ServiceStatusBadge}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A2D24" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                                <Setter Property="Background" Value="#3B1D25" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Ellipse Width="8" Height="8" Margin="4,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ServiceStatusBadge}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Width="170"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisConverter}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Lock Dashboard Button -->
                            <Button Command="{Binding LockCommand}" Style="{StaticResource ModernSecondaryButton}" Height="34" FontSize="12"
                                    ToolTip="Lock Dashboard with Master PIN">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="13" />
                                    <TextBlock Text=" Lock Dashboard" FontSize="12"
                                               Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisConverter}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area with Tab Switching -->
            <Grid Grid.Column="1" Background="{StaticResource BgMainBrush}">
                <!-- Apps Tab (Index 0) -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=0}">
                    <views:AppsView DataContext="{Binding AppsVM}" />
                </Grid>

                <!-- Websites Tab (Index 1) -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=1}">
                    <views:WebsitesView DataContext="{Binding WebsitesVM}" />
                </Grid>

                <!-- Schedules Tab (Index 2) -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=2}">
                    <views:SchedulesView DataContext="{Binding SchedulesVM}" />
                </Grid>

                <!-- Logs Tab (Index 3) -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=3}">
                    <views:LogsView DataContext="{Binding LogsVM}" />
                </Grid>

                <!-- Settings Tab (Index 4) -->
                <Grid Visibility="{Binding SelectedTabIndex, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=4}">
                    <views:SettingsView DataContext="{Binding SettingsVM}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
