<UserControl x:Class="AppBlocker.UI.Views.LockScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:AppBlocker.UI.Services"
             mc:Ignorable="d" 
             FontFamily="Segoe UI, Nirmala UI, Iskoola Pota, sans-serif"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="{StaticResource BgMainBrush}">
        <!-- Subtle radial glow background -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="480"
                Style="{StaticResource ModernCard}"
                Effect="{DynamicResource ShadowEffect}">
            <Border.Resources>
                <DropShadowEffect x:Key="ShadowEffect" BlurRadius="40" Color="#5B21B6" Opacity="0.3" ShadowDepth="0" />
            </Border.Resources>
            
            <StackPanel>
                <!-- Top Row: Language Toggle Selector -->
                <Grid Margin="0,0,0,10">
                    <Button HorizontalAlignment="Right"
                            Command="{Binding ToggleLanguageCommand}"
                            Style="{StaticResource ModernSecondaryButton}"
                            Padding="8,3" Height="28"
                            ToolTip="{Binding Loc.SwitchLanguageTooltip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Loc.CurrentLanguageDisplay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Shield Icon & Header -->
                <Border Width="64" Height="64" CornerRadius="32" Background="#261E40" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="🔒" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="{loc:Loc Brand_Title}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Loc Brand_Subtitle}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,20" />

                <!-- Mode Indicator -->
                <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,20" HorizontalAlignment="Stretch">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1E2235" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSetupMode}" Value="True">
                                    <Setter Property="Background" Value="#2A1B3D" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{loc:Loc Lock_EnterMasterPin}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSetupMode}" Value="True">
                                        <Setter Property="Text" Value="{loc:Loc Lock_SetupTitle}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- PIN Input Box -->
                <TextBlock Text="{loc:Loc Lock_MasterPin}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,12">
                    <PasswordBox x:Name="MasterPasswordBox"
                                 FontSize="20"
                                 FontWeight="Bold"
                                 HorizontalContentAlignment="Center"
                                 Style="{StaticResource ModernPasswordBox}"
                                 Padding="38,10,38,10"
                                 Visibility="{Binding IsPinVisible, Converter={StaticResource InverseBoolToVisConverter}}" />
                    <TextBox x:Name="MasterTextBox"
                             Text="{Binding PinInput, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="20"
                             FontWeight="Bold"
                             HorizontalContentAlignment="Center"
                             Style="{StaticResource ModernTextBox}"
                             Padding="38,10,38,10"
                             Visibility="{Binding IsPinVisible, Converter={StaticResource BoolToVisConverter}}" />
                    <Button Command="{Binding TogglePinVisibilityCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Width="34" Height="34"
                            Style="{StaticResource ModernSecondaryButton}"
                            Padding="0"
                            ToolTip="{loc:Loc Lock_ShowPin}">
                        <TextBlock FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="👁️" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinVisible}" Value="True">
                                            <Setter Property="Text" Value="🙈" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <!-- Confirm PIN Box (Shown in Setup Mode only) -->
                <StackPanel Visibility="{Binding IsSetupMode, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{loc:Loc Lock_ConfirmPin}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     FontSize="20"
                                     FontWeight="Bold"
                                     HorizontalContentAlignment="Center"
                                     Style="{StaticResource ModernPasswordBox}"
                                     Padding="38,10,38,10"
                                     Visibility="{Binding IsConfirmPinVisible, Converter={StaticResource InverseBoolToVisConverter}}" />
                        <TextBox x:Name="ConfirmTextBox"
                                 Text="{Binding ConfirmPinInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="20"
                                 FontWeight="Bold"
                                 HorizontalContentAlignment="Center"
                                 Style="{StaticResource ModernTextBox}"
                                 Padding="38,10,38,10"
                                 Visibility="{Binding IsConfirmPinVisible, Converter={StaticResource BoolToVisConverter}}" />
                        <Button Command="{Binding ToggleConfirmPinVisibilityCommand}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Width="34" Height="34"
                                Style="{StaticResource ModernSecondaryButton}"
                                Padding="0"
                                ToolTip="{loc:Loc Lock_ShowPin}">
                            <TextBlock FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="👁️" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfirmPinVisible}" Value="True">
                                                <Setter Property="Text" Value="🙈" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Status / Error Notification -->
                <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,16"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#223326" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="#3B1D25" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Numeric Keypad Grid -->
                <Grid Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="46" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource ModernSecondaryButton}" Margin="4" Command="{Binding AppendDigitCommand}" CommandParameter="1" FontSize="16" />
                    <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource ModernSecondaryButton}" Margin="4" Command="{Binding AppendDigitCommand}" CommandParameter="2" FontSize="16" />
                    <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource ModernSecondaryButton}" Margin="4" Command="{Binding AppendDigitCommand}" CommandParameter="3" FontSize="16" />

                    <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource ModernSecondaryButton}" Margin="4" Command="{Binding AppendDigitCommand}" CommandParameter="4" FontSize="16" />
                    <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource ModernSecondaryButton}" Margin="4" Command="{Binding AppendDigitCommand}" CommandParameter="5" FontSize="16" />
                    <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource ModernSecondaryButton}" Margin="4" Command="{Binding AppendDigitCommand}" CommandParameter="6" FontSize="16" />

                    <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource ModernSecondaryButton}" Margin="4" Command="{Binding AppendDigitCommand}" CommandParameter="7" FontSize="16" />
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource ModernSecondaryButton}" Margin="4" Command="{Binding AppendDigitCommand}" CommandParameter="8" FontSize="16" />
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource ModernSecondaryButton}" Margin="4" Command="{Binding AppendDigitCommand}" CommandParameter="9" FontSize="16" />

                    <Button Grid.Row="3" Grid.Column="0" Content="C" Style="{StaticResource ModernSecondaryButton}" Margin="4" Command="{Binding ClearCommand}" Foreground="{StaticResource DangerBrush}" FontSize="14" FontWeight="Bold" />
                    <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource ModernSecondaryButton}" Margin="4" Command="{Binding AppendDigitCommand}" CommandParameter="0" FontSize="16" />
                    <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource ModernSecondaryButton}" Margin="4" Command="{Binding BackspaceCommand}" FontSize="16" />
                </Grid>

                <!-- Action Submit Button -->
                <Button Command="{Binding SubmitCommand}" Style="{StaticResource ModernPrimaryButton}" Height="44">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔓  " FontSize="14" />
                        <TextBlock FontSize="14" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{loc:Loc Lock_UnlockBtn}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSetupMode}" Value="True">
                                            <Setter Property="Text" Value="{loc:Loc Lock_SetupBtn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!-- Security Footer -->
                <TextBlock Text="{loc:Loc Lock_SecurityNotice}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
