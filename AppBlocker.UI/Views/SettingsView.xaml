<UserControl x:Class="AppBlocker.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:AppBlocker.UI.Services"
             FontFamily="Segoe UI, Nirmala UI, Iskoola Pota, sans-serif"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{loc:Loc Settings_Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{loc:Loc Settings_Subtitle}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status Banner (with 30-sec Auto-Dismiss & Manual Close) -->
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,20"
                    Visibility="{Binding GeneralStatusMessage, Converter={StaticResource StringNotEmptyToVisConverter}}"
                    Background="#1E3326">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding GeneralStatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="13" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="✕" Command="{Binding DismissGeneralStatusCommand}"
                            Style="{StaticResource ModernSecondaryButton}"
                            Padding="8,2" Height="26" FontSize="11" Margin="10,0,0,0"
                            ToolTip="Dismiss notification" />
                </Grid>
            </Border>

            <!-- 🩺 1-Click System Diagnostics & Self-Healing Wizard Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20" CornerRadius="12" Padding="20">
                <StackPanel>
                    <!-- Header & Action Row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🩺 " FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Diag_Title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                
                                <!-- Health Score Badge -->
                                <Border Margin="14,0,0,0" CornerRadius="12" Padding="10,3" VerticalAlignment="Center"
                                        Background="#1E293B" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding DiagnosticsBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding DiagnosticsSummaryText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{loc:Loc Diag_RunBtn}"
                                    Command="{Binding RunDiagnosticsCommand}"
                                    IsEnabled="{Binding IsDiagnosticsRunning, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    Height="38" Padding="14,6" Margin="0,0,10,0" />

                            <Button Content="{loc:Loc Diag_AutoRepairBtn}"
                                    Command="{Binding AutoRepairAllCommand}"
                                    IsEnabled="{Binding IsDiagnosticsRunning, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource ModernPrimaryButton}"
                                    Background="{StaticResource SuccessBrush}"
                                    Height="38" Padding="16,6" />
                        </StackPanel>
                    </Grid>

                    <!-- Loading / Scan in progress indicator -->
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,14"
                                 Visibility="{Binding IsDiagnosticsRunning, Converter={StaticResource BoolToVisConverter}}"
                                 Foreground="{StaticResource AccentCyanBrush}" Background="#1A2035" BorderThickness="0" />

                    <!-- Checklist of 9 Diagnostic Items -->
                    <ItemsControl ItemsSource="{Binding DiagnosticItems}"
                                  Visibility="{Binding IsDiagnosticsCompleted, Converter={StaticResource BoolToVisConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" 
                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Icon -->
                                        <TextBlock Grid.Column="0" Text="{Binding Status, Converter={StaticResource DiagnosticIconConverter}}" 
                                                   FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Left" />

                                        <!-- Name & Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text=" • " FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Status Pill Badge -->
                                        <Border Grid.Column="2" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,10,0"
                                                Background="{Binding Status, Converter={StaticResource DiagnosticBgConverter}}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource DiagnosticColorConverter}}" />
                                        </Border>

                                        <!-- Individual Fix Button -->
                                        <Button Grid.Column="3"
                                                Content="Fix Issue"
                                                Command="{Binding DataContext.RepairSpecificItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}"
                                                Visibility="{Binding CanAutoRepair, Converter={StaticResource BoolToVisConverter}}"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                Height="28" Padding="10,2" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Safe Child Mode (Parental Shield) Card -->
            <Border Margin="0,0,0,20" CornerRadius="12" Padding="20">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ModernCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSafeChildModeEnabled}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}" />
                                <Setter Property="Background" Value="#17162B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <!-- Header with Master Toggle -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="👶🛡️ " FontSize="18" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc SafeChild_Title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding SafeChildStatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Master Switch Button -->
                        <Button Grid.Column="1"
                                Command="{Binding ToggleSafeChildModeCommand}"
                                VerticalAlignment="Center"
                                Height="42" Padding="18,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernPrimaryButton}">
                                    <Setter Property="Content" Value="{loc:Loc SafeChild_Enable}" />
                                    <Setter Property="Background" Value="{StaticResource AccentPurpleBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSafeChildModeEnabled}" Value="True">
                                            <Setter Property="Content" Value="{loc:Loc SafeChild_Active}" />
                                            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Sub-Category Protections -->
                    <StackPanel>
                        <!-- 1. Adult & Explicit Content / Gambling -->
                        <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc SafeChild_Adult}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Loc SafeChild_AdultDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding SafeChildBlockAdultSites}"
                                          Command="{Binding SaveSafeChildSettingsCommand}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand" />
                            </Grid>
                        </Border>

                        <!-- 2. Social Media Restriction -->
                        <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc SafeChild_Social}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Loc SafeChild_SocialDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding SafeChildBlockSocialMedia}"
                                          Command="{Binding SaveSafeChildSettingsCommand}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand" />
                            </Grid>
                        </Border>

                        <!-- 3. Addictive Gaming Launchers & Web Games -->
                        <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc SafeChild_Gaming}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Loc SafeChild_GamingDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding SafeChildBlockGaming}"
                                          Command="{Binding SaveSafeChildSettingsCommand}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand" />
                            </Grid>
                        </Border>

                        <!-- 4. SafeSearch Enforcement -->
                        <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc SafeChild_SafeSearch}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Loc SafeChild_SafeSearchDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding SafeChildEnforceSafeSearch}"
                                          Command="{Binding SaveSafeChildSettingsCommand}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand" />
                            </Grid>
                        </Border>

                        <!-- 5. VPN, Tor & Web Proxy Circumvention Shield -->
                        <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc SafeChild_Vpn}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{loc:Loc SafeChild_VpnDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding SafeChildBlockVpnAndBypass}"
                                          Command="{Binding SaveSafeChildSettingsCommand}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Background Daemon Status Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_DaemonTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding ServiceStatusText}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="Runs as LocalSystem with automatic Watchdog recovery on crash" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Connection Badge -->
                        <Border Grid.Column="1" CornerRadius="12" Padding="12,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1A2D24" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                            <Setter Property="Background" Value="#3B1D25" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="CONNECTED" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServiceConnected}" Value="False">
                                                <Setter Property="Text" Value="OFFLINE" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- Pause / Resume Controls -->
                    <TextBlock Text="Global Blocking Controls" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="⏸️ Pause 15m" Command="{Binding PauseBlockingCommand}" CommandParameter="15" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,10,8" />
                        <Button Content="⏸️ Pause 30m" Command="{Binding PauseBlockingCommand}" CommandParameter="30" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,10,8" />
                        <Button Content="⏸️ Pause 1h" Command="{Binding PauseBlockingCommand}" CommandParameter="60" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,10,8" />
                        <Button Content="⏸️ Pause Indefinitely" Command="{Binding PauseBlockingCommand}" CommandParameter="0" Style="{StaticResource ModernSecondaryButton}" Margin="0,0,10,8" />
                        <Button Content="▶️ Resume Blocking" Command="{Binding ResumeBlockingCommand}" Style="{StaticResource ModernPrimaryButton}" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Anti-Tamper & Task Manager Lockdown Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Windows Task Manager Lockdown" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Restricts Task Manager (DisableTaskMgr = 1 in Policies\System) to prevent process tampering." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Automatically restored when the dashboard is unlocked by Master PIN or when blocking is paused." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding ToggleTaskManagerCommand}"
                            VerticalAlignment="Center"
                            Height="38" Padding="14,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
                                <Setter Property="Content" Value="🛡️ TaskMgr Enabled" />
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTaskManagerDisabled}" Value="True">
                                        <Setter Property="Content" Value="🔒 TaskMgr Locked" />
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Browser Anti-Bypass & Leak Shield Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Browser Anti-Bypass &amp; Leak Shield" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="Enforces enterprise policies across Chrome, Edge, and Brave to prevent private browsing and DNS bypasses." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                    <!-- 1. Incognito / InPrivate Restriction -->
                    <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Disable Incognito / InPrivate Browsing" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Greys out 'New incognito window' and disables Ctrl+Shift+N in Chrome, Edge, and Brave." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding ToggleIncognitoCommand}"
                                    VerticalAlignment="Center"
                                    Height="34" Padding="12,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
                                        <Setter Property="Content" Value="🛡️ Incognito Blocked" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsIncognitoDisabled}" Value="False">
                                                <Setter Property="Content" Value="⚠️ Incognito Allowed" />
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 2. DNS-over-HTTPS (DoH) Leak Shield -->
                    <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Disable DNS-over-HTTPS (DoH) Leaks" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Forces browsers to route through the OS proxy instead of encrypting DNS queries to third-party resolvers." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding ToggleDnsOverHttpsCommand}"
                                    VerticalAlignment="Center"
                                    Height="34" Padding="12,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
                                        <Setter Property="Content" Value="🛡️ DoH Leaks Blocked" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDnsOverHttpsDisabled}" Value="False">
                                                <Setter Property="Content" Value="⚠️ DoH Active" />
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 3. Mozilla Firefox Proxy Hardening & Enterprise Roots -->
                    <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Lock Mozilla Firefox to System Proxy &amp; Trust Roots" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Locks Firefox network configuration to use Guardian proxy, trusts Windows enterprise root certificates, and disables private windows." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Command="{Binding ToggleFirefoxProxyLockCommand}"
                                    VerticalAlignment="Center"
                                    Height="34" Padding="12,6">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
                                        <Setter Property="Content" Value="🛡️ Firefox Proxy Locked" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFirefoxProxyLocked}" Value="False">
                                                <Setter Property="Content" Value="⚠️ Firefox Unrestricted" />
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Layer 4 Dual-Process Mutual Watchdog Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Layer 4 Dual-Process Mutual Watchdog" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Continuous 500ms mutual PID monitoring between AppBlocker.Service and AppBlocker.Watchdog. If terminated via Terminal ('taskkill /F') or Task Manager without authorized PIN shutdown, the companion immediately resurrects the service." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Watchdog Status Badge -->
                        <Border Grid.Column="1" CornerRadius="14" Padding="12,6" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1A10B981" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWatchdogActive}" Value="False">
                                            <Setter Property="Background" Value="#1AEF4444" />
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️ " FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding WatchdogStatusText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWatchdogActive}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Windows Startup & Silent Tray Auto-Launch Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🚀 Launch CrackerBlock on Windows Startup" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Automatically launches CrackerBlock in silent system tray mode when Windows starts, keeping protection and desktop alerts active." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding IsLaunchOnStartupEnabled}"
                              VerticalAlignment="Center"
                              Cursor="Hand" />
                </Grid>
            </Border>

            <!-- Desktop Notifications & Real-Time Alerts Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Desktop Toast Notifications &amp; Real-Time Alerts" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Non-activating desktop HUD alerts and system tray notifications when applications/sites are restricted or focus milestones occur." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="🔔 Send Test Notification"
                                Command="{Binding SendTestNotificationCommand}"
                                Style="{StaticResource ModernPrimaryButton}"
                                VerticalAlignment="Center"
                                Height="36" Padding="14,6" />
                    </Grid>

                    <!-- Alert Preference Rows -->
                    <StackPanel>
                        <!-- 1. Floating Desktop Toasts -->
                        <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Floating Desktop HUD Toasts" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Smooth glassmorphic toast windows in the bottom-right corner without stealing focus or interrupting full-screen games." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsToastNotificationsEnabled}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand" />
                            </Grid>
                        </Border>

                        <!-- 2. Sound Effects -->
                        <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Notification Sound Chimes" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Play subtle audio cues when anti-tamper shields activate or focus sessions complete." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsNotificationSoundEnabled}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand" />
                            </Grid>
                        </Border>

                        <!-- 3. System Tray Balloon Tips -->
                        <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Windows Action Center &amp; System Tray Alerts" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Mirror alerts into the native Windows notification area and system tray icon balloon tips." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IsBalloonAlertsEnabled}"
                                          VerticalAlignment="Center"
                                          Cursor="Hand" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Network Tools Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Network DNS Resolver Cache" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Instantly flush local DNS cache via DnsFlushResolverCache / ipconfig to enforce web filtering." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="⚡ Flush DNS Cache"
                            Command="{Binding FlushDnsCommand}"
                            Style="{StaticResource ModernSecondaryButton}"
                            VerticalAlignment="Center"
                            Height="38" />
                </Grid>
            </Border>

            <!-- Master PIN Management Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_PinTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                    <!-- Status Notification -->
                    <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding PinStatusMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1E3326" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinSuccess}" Value="False">
                                        <Setter Property="Background" Value="#3B1D25" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding PinStatusMessage}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinSuccess}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="{loc:Loc Settings_PinCurrent}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding CurrentPinInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                            <TextBlock Text="{loc:Loc Settings_PinNew}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding NewPinInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,12">
                            <TextBlock Text="{loc:Loc Settings_PinConfirm}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding ConfirmPinInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,0,12">
                            <Button Content="{loc:Loc Settings_PinUpdateBtn}" Command="{Binding ChangePinCommand}" Style="{StaticResource ModernPrimaryButton}" Height="38" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 🌐 Language Preference Card (භාෂාව තේරීම) -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="🌐 " FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Settings_LanguageTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{loc:Loc Settings_LanguageDesc}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Language Switcher Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding SetLanguageEnglishCommand}"
                                Height="38" Padding="14,6" Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderCardBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Loc.IsEnglish}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}" />
                                            <Setter Property="Background" Value="#2A1B4E" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🇺🇸 " FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="English" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SetLanguageSinhalaCommand}"
                                Height="38" Padding="14,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderCardBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Loc.IsSinhala}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}" />
                                            <Setter Property="Background" Value="#2A1B4E" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🇱🇰 " FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="සිංහල" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Lock Dashboard Action -->
            <Border Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_LockTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{loc:Loc Settings_LockDesc}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="{loc:Loc Settings_LockBtn}"
                            Command="{Binding LockDashboardCommand}"
                            Style="{StaticResource ModernSecondaryButton}"
                            Height="38" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
