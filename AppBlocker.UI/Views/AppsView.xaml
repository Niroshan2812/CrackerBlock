<UserControl x:Class="AppBlocker.UI.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Application Blocking Engine" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Block desktop software, executables, games, and background processes natively." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status Banner (with 30-sec Auto-Dismiss & Manual Close) -->
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,20"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1E3326" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccessMessage}" Value="False">
                                <Setter Property="Background" Value="#3B1D25" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="13" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessMessage}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Content="✕" Command="{Binding DismissStatusCommand}"
                            Style="{StaticResource ModernSecondaryButton}"
                            Padding="8,2" Height="26" FontSize="11" Margin="10,0,0,0"
                            ToolTip="Dismiss notification" />
                </Grid>
            </Border>

            <!-- Add Rule Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Add New Application Rule" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <!-- Quick App Selection Chips -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                        <TextBlock Text="⚡ Quick Pick:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="🎮 Steam" Command="{Binding SelectQuickAppCommand}" CommandParameter="steam" Style="{StaticResource ModernSecondaryButton}" Padding="8,4" Height="28" Margin="0,0,6,0" FontSize="11" />
                        <Button Content="💬 Discord" Command="{Binding SelectQuickAppCommand}" CommandParameter="discord" Style="{StaticResource ModernSecondaryButton}" Padding="8,4" Height="28" Margin="0,0,6,0" FontSize="11" />
                        <Button Content="🎵 Spotify" Command="{Binding SelectQuickAppCommand}" CommandParameter="spotify" Style="{StaticResource ModernSecondaryButton}" Padding="8,4" Height="28" Margin="0,0,6,0" FontSize="11" />
                        <Button Content="🌐 Chrome" Command="{Binding SelectQuickAppCommand}" CommandParameter="chrome" Style="{StaticResource ModernSecondaryButton}" Padding="8,4" Height="28" Margin="0,0,6,0" FontSize="11" />
                        <Button Content="🎬 VLC" Command="{Binding SelectQuickAppCommand}" CommandParameter="vlc" Style="{StaticResource ModernSecondaryButton}" Padding="8,4" Height="28" Margin="0,0,6,0" FontSize="11" />
                        <Button Content="📝 Notepad" Command="{Binding SelectQuickAppCommand}" CommandParameter="notepad" Style="{StaticResource ModernSecondaryButton}" Padding="8,4" Height="28" Margin="0,0,6,0" FontSize="11" />
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Process Name / Exe Path with watermark hint -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="Process Name (e.g. discord, steam, spotify, calc)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Grid>
                                <TextBox Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" />
                                <TextBlock Text="Enter executable name or select below..."
                                           IsHitTestVisible="False"
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"
                                           Visibility="{Binding NewProcessName, Converter={StaticResource StringEmptyToVisConverter}}" />
                            </Grid>
                        </StackPanel>

                        <!-- Browse Exe & Running App Pickers -->
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,12,12">
                            <Button Content="📁 Browse .exe" Command="{Binding BrowseExeCommand}" Style="{StaticResource ModernSecondaryButton}" Height="38" Margin="0,0,6,0" ToolTip="Browse your computer for an executable file" />
                            <ComboBox ItemsSource="{Binding RunningProcesses}"
                                      SelectedItem="{Binding NewProcessName, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBox}"
                                      Height="38" Width="140"
                                      ToolTip="Pick an application currently running right now">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='⚡ {0}'}" FontSize="12" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Schedule Selector -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,12">
                            <TextBlock Text="Enforcement Schedule" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding SelectedSchedule}" Style="{StaticResource ModernComboBox}" Height="38" />
                        </StackPanel>

                        <!-- Add Rule Button -->
                        <StackPanel Grid.Row="0" Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,0,12">
                            <Button Content="➕ Block Application" Command="{Binding AddRuleCommand}" Style="{StaticResource ModernPrimaryButton}" Height="38" />
                        </StackPanel>

                        <!-- Full Path Info Preview if selected -->
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="4"
                                   Text="{Binding NewExePath, StringFormat='Selected Binary Path: {0}'}"
                                   FontSize="11" Foreground="{StaticResource AccentCyanBrush}"
                                   Visibility="{Binding NewExePath, Converter={StaticResource StringNotEmptyToVisConverter}}" Margin="0,0,0,8" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Rules List Card -->
            <Border Style="{StaticResource ModernCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Managed Restricted Applications" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Rules.Count, StringFormat='Total Rules: {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Rules ItemsControl -->
                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon -->
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="#261E40" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1" Margin="0,0,12,0">
                                            <TextBlock Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Process details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ProcessName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                <Border CornerRadius="4" Padding="6,2" Background="#261E40" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding ScheduleType}" FontSize="11" Foreground="{StaticResource AccentPurpleBrush}" FontWeight="SemiBold" />
                                                </Border>
                                                <Border CornerRadius="4" Padding="6,2" Background="#2E1E3A"
                                                        Visibility="{Binding IsTemporarilyUnlocked, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="🔓 TEMPORARILY UNLOCKED" FontSize="10" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ExePath, TargetNullValue='Global process matching'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Status Badge & Toggle -->
                                        <Button Grid.Column="2"
                                                Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,8,0" Height="32" Padding="8,4" FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
                                                    <Setter Property="Content" Value="Active" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Content" Value="Paused" />
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Dynamic Temporary Unlock & Relock with Custom Duration Options -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,8,0">
                                            <!-- Main Toggle / Relock Button -->
                                            <Button Content="{Binding UnlockButtonText}"
                                                    Command="{Binding DataContext.TemporaryUnlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Height="32" Padding="10,4" FontSize="11">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderCardBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTemporarilyUnlocked}" Value="True">
                                                                <Setter Property="Background" Value="#2E1E3A" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}" />
                                                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Preset Duration Buttons (Visible when locked) -->
                                            <StackPanel Orientation="Horizontal" Margin="4,0,0,0"
                                                        Visibility="{Binding IsTemporarilyUnlocked, Converter={StaticResource InverseBoolToVisConverter}}">
                                                <Button Content="30m"
                                                        Command="{Binding DataContext.Unlock30mCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ModernSecondaryButton}"
                                                        Height="32" Padding="6,2" FontSize="10" Margin="0,0,2,0"
                                                        ToolTip="Unlock for 30 minutes" />
                                                <Button Content="1h"
                                                        Command="{Binding DataContext.Unlock60mCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ModernSecondaryButton}"
                                                        Height="32" Padding="6,2" FontSize="10"
                                                        ToolTip="Unlock for 1 hour" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Delete Button -->
                                        <Button Grid.Column="4"
                                                Content="🗑️ Delete"
                                                Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ModernDangerButton}"
                                                Height="32" Padding="10,4" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state text: now hides when Rules.Count > 0 -->
                    <TextBlock Text="No application rules configured yet. Add an executable above to start locking."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextAlignment="Center" Margin="0,20,0,10"
                               Visibility="{Binding Rules.Count, Converter={StaticResource InverseBoolToVisConverter}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
