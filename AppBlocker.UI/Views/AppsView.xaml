<UserControl x:Class="AppBlocker.UI.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Application Blocking Engine" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Block desktop software, executables, games, and background processes natively." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status Banner -->
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,20"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1E3326" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccessMessage}" Value="False">
                                <Setter Property="Background" Value="#3B1D25" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccessMessage}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- Add Rule Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Add New Application Rule" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Process Name / Exe Path -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="Process Name (e.g. calc, spotify, steam)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <!-- Browse Exe Button -->
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,12,12">
                            <Button Content="📁 Browse .exe" Command="{Binding BrowseExeCommand}" Style="{StaticResource ModernSecondaryButton}" Height="38" />
                        </StackPanel>

                        <!-- Schedule Selector -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,12">
                            <TextBlock Text="Enforcement Schedule" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding SelectedSchedule}" Style="{StaticResource ModernComboBox}" Height="38" />
                        </StackPanel>

                        <!-- Add Rule Button -->
                        <StackPanel Grid.Row="0" Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,0,12">
                            <Button Content="➕ Block Application" Command="{Binding AddRuleCommand}" Style="{StaticResource ModernPrimaryButton}" Height="38" />
                        </StackPanel>

                        <!-- Full Path Info Preview if selected -->
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="4"
                                   Text="{Binding NewExePath, StringFormat='Selected Path: {0}'}"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding NewExePath, Converter={StaticResource StringNotEmptyToVisConverter}}" Margin="0,0,0,8" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Rules List Card -->
            <Border Style="{StaticResource ModernCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Managed Restricted Applications" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Rules.Count, StringFormat='Total Rules: {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Rules ItemsControl -->
                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="#261E40" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1" Margin="0,0,12,0">
                                            <TextBlock Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Process details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ProcessName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                <Border CornerRadius="4" Padding="6,2" Background="#261E40">
                                                    <TextBlock Text="{Binding ScheduleType}" FontSize="11" Foreground="{StaticResource AccentPurpleBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ExePath, TargetNullValue='Global process matching'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Status Badge & Toggle -->
                                        <Button Grid.Column="2"
                                                Content="{Binding IsActive, Converter={StaticResource InverseBoolConverter}, ConverterParameter='Active', Mode=OneWay}"
                                                Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,8,0" Height="32" Padding="8,4" FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
                                                    <Setter Property="Content" Value="Active" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Content" Value="Paused" />
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Temporary Unlock (15m) Button -->
                                        <Button Grid.Column="3"
                                                Content="⏱️ Unlock 15m"
                                                Command="{Binding DataContext.TemporaryUnlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ModernSecondaryButton}"
                                                Margin="0,0,8,0" Height="32" Padding="8,4" FontSize="11" />

                                        <!-- Delete Button -->
                                        <Button Grid.Column="4"
                                                Content="🗑️ Delete"
                                                Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ModernDangerButton}"
                                                Height="32" Padding="10,4" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No application rules configured yet. Add an executable above to start locking."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextAlignment="Center" Margin="0,20,0,10"
                               Visibility="{Binding Rules.Count, Converter={StaticResource InverseBoolToVisConverter}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
