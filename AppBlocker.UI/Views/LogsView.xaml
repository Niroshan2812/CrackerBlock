<UserControl x:Class="AppBlocker.UI.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="1100" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header & Time Range Selection -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Productivity &amp; Distraction Analytics" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Live distraction telemetry, time saved, top intercepted apps/domains, and forensic audit trail." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Time Range Filter Chips -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Today"
                            Command="{Binding SelectTimeRangeCommand}"
                            CommandParameter="Today"
                            Style="{StaticResource ModernSecondaryButton}"
                            Height="34" Margin="0,0,8,0" Padding="12,4" />
                    <Button Content="Past 7 Days"
                            Command="{Binding SelectTimeRangeCommand}"
                            CommandParameter="Week"
                            Style="{StaticResource ModernSecondaryButton}"
                            Height="34" Margin="0,0,8,0" Padding="12,4" />
                    <Button Content="All Time"
                            Command="{Binding SelectTimeRangeCommand}"
                            CommandParameter="AllTime"
                            Style="{StaticResource ModernPrimaryButton}"
                            Height="34" Padding="14,4" />
                </StackPanel>
            </Grid>

            <!-- 1. Executive KPI Cards Grid (4 columns) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Interceptions -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,12,0" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🛡️ " FontSize="14" />
                            <TextBlock Text="TOTAL BLOCKS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalInterceptions}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding TotalAppsBlocked, StringFormat='{}{0} apps / '}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                            <TextBlock.Inlines>
                                <Run Text="{Binding TotalAppsBlocked, Mode=OneWay}" />
                                <Run Text=" apps, " />
                                <Run Text="{Binding TotalWebsBlocked, Mode=OneWay}" />
                                <Run Text=" domains" />
                            </TextBlock.Inlines>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Time Saved -->
                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="0,0,12,0" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⏳ " FontSize="14" />
                            <TextBlock Text="TIME PRESERVED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TimeSavedDisplay}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Est. 5 mins / distraction saved" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- KPI 3: Focus Score -->
                <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="0,0,12,0" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⚡ " FontSize="14" />
                            <TextBlock Text="FOCUS SCORE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding FocusScoreDisplay}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                        <TextBlock Text="Based on sprints &amp; policy adherence" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- KPI 4: Tamper Defense -->
                <Border Grid.Column="3" Style="{StaticResource ModernCard}" Padding="18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🔒 " FontSize="14" />
                            <TextBlock Text="TAMPER INTERCEPTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TamperAttemptsCount}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="Watchdog &amp; security barriers" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Top Distractors Breakdown (2 columns) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Top Apps -->
                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,12,0" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="💻 " FontSize="16" />
                            <TextBlock Text="Top Blocked Applications" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding TopBlockedApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding DisplayCount}" FontSize="12" Foreground="{StaticResource AccentPurpleBrush}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                        <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="6" Background="#1E2338" Foreground="{StaticResource AccentPurpleBrush}" BorderThickness="0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No application blocks recorded in this time window."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0"
                                   Visibility="{Binding TopBlockedApps.Count, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=0}" />
                    </StackPanel>
                </Border>

                <!-- Right Column: Top Domains -->
                <Border Grid.Column="1" Style="{StaticResource ModernCard}" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="🌐 " FontSize="16" />
                            <TextBlock Text="Top Blocked Websites &amp; Redirects" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding TopBlockedWebsites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding DisplayCount}" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                        <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="6" Background="#1E2338" Foreground="{StaticResource AccentCyanBrush}" BorderThickness="0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No website interceptions recorded in this time window."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0"
                                   Visibility="{Binding TopBlockedWebsites.Count, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=0}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Audit Log Filter Bar & Search -->
            <Border Style="{StaticResource ModernCard}" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Category Chips -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Filter by:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        
                        <Button Content="All Logs"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="All"
                                Style="{StaticResource ModernSecondaryButton}"
                                Height="30" Margin="0,0,6,0" Padding="10,2" />
                        <Button Content="💻 Blocked Apps"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Blocked Apps"
                                Style="{StaticResource ModernSecondaryButton}"
                                Height="30" Margin="0,0,6,0" Padding="10,2" />
                        <Button Content="🌐 Blocked Web"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Blocked Web"
                                Style="{StaticResource ModernSecondaryButton}"
                                Height="30" Margin="0,0,6,0" Padding="10,2" />
                        <Button Content="🛡️ Anti-Tamper"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Anti-Tamper"
                                Style="{StaticResource ModernSecondaryButton}"
                                Height="30" Margin="0,0,6,0" Padding="10,2" />
                        <Button Content="🍅 Focus Sprints"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="Focus Sprints"
                                Style="{StaticResource ModernSecondaryButton}"
                                Height="30" Margin="0,0,6,0" Padding="10,2" />
                        <Button Content="🔑 PIN Security"
                                Command="{Binding SelectCategoryCommand}"
                                CommandParameter="PIN Security"
                                Style="{StaticResource ModernSecondaryButton}"
                                Height="30" Padding="10,2" />
                    </StackPanel>

                    <!-- Search & Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Height="36"
                                 Margin="0,0,12,0" />

                        <Button Grid.Column="1"
                                Content="📥 Export CSV"
                                Command="{Binding ExportToCsvCommand}"
                                Style="{StaticResource ModernSecondaryButton}"
                                Height="36" Margin="0,0,10,0" Padding="14,6" />

                        <Button Grid.Column="2"
                                Content="🔄 Refresh"
                                Command="{Binding RefreshLogsCommand}"
                                Style="{StaticResource ModernSecondaryButton}"
                                Height="36" Margin="0,0,10,0" Padding="14,6" />

                        <Button Grid.Column="3"
                                Content="🗑️ Clear Logs"
                                Command="{Binding ClearLogsCommand}"
                                Style="{StaticResource ModernDangerButton}"
                                Height="36" Padding="14,6" />
                    </Grid>

                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 4. Forensic Audit Table -->
            <Border Style="{StaticResource ModernCard}" Padding="8">
                <DataGrid ItemsSource="{Binding Logs}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderCardBrush}"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{StaticResource BgSidebarBrush}"
                          BorderThickness="0"
                          Foreground="{StaticResource TextPrimaryBrush}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BgSidebarBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="FontSize" Value="13" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- Timestamp -->
                        <DataGridTextColumn Header="Timestamp (UTC)" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="10,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Event Type Badge -->
                        <DataGridTemplateColumn Header="Event Category" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#22263B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EventType}" Value="Blocked App">
                                                        <Setter Property="Background" Value="#3B1D25" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EventType}" Value="Blocked Web">
                                                        <Setter Property="Background" Value="#172733" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EventType}" Value="Tamper Detected">
                                                        <Setter Property="Background" Value="#3B261D" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EventType}" Value="Failed PIN">
                                                        <Setter Property="Background" Value="#3B1D25" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EventType}" Value="Successful PIN Login">
                                                        <Setter Property="Background" Value="#1A2D24" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EventType}" Value="Service Started">
                                                        <Setter Property="Background" Value="#1A2D24" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding EventType}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EventType}" Value="Blocked App">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EventType}" Value="Blocked Web">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EventType}" Value="Tamper Detected">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EventType}" Value="Failed PIN">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EventType}" Value="Successful PIN Login">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EventType}" Value="Service Started">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Description -->
                        <DataGridTextColumn Header="Details &amp; Parameters" Binding="{Binding Description}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="10,0" />
                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
