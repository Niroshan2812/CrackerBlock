<UserControl x:Class="AppBlocker.UI.Views.WebsitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Web Filtering Engine" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Block distracting websites and web domains across all browsers at the Windows OS network level." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status Banner with 30-sec Auto-Dismiss & Manual Close -->
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,20"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1E3326" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccessMessage}" Value="False">
                                <Setter Property="Background" Value="#3B1D25" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="13" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessMessage}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Content="✕" Command="{Binding DismissStatusCommand}"
                            Style="{StaticResource ModernSecondaryButton}"
                            Padding="8,2" Height="26" FontSize="11" Margin="10,0,0,0"
                            ToolTip="Dismiss notification" />
                </Grid>
            </Border>

            <!-- Add Website Card -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Add New Website Filter &amp; Redirect Rule" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <!-- Two-column input for Domain and Redirect URL -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- URL or Domain input with watermark hint -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Target Domain / URL to Intercept (e.g. youtube.com, tiktok.com)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Grid>
                                <TextBox Text="{Binding NewUrlOrDomain, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" />
                                <TextBlock Text="e.g. facebook.com, youtube.com, or nano.gov"
                                           IsHitTestVisible="False"
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"
                                           Visibility="{Binding NewUrlOrDomain, Converter={StaticResource StringEmptyToVisConverter}}" />
                            </Grid>
                        </StackPanel>

                        <!-- Redirect URL input (Optional) with watermark hint -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Redirect To URL (Optional, e.g. https://en.wikipedia.org)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Grid>
                                <TextBox Text="{Binding NewRedirectUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="38" />
                                <TextBlock Text="Optional redirect URL (e.g. https://wikipedia.org)"
                                           IsHitTestVisible="False"
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"
                                           Visibility="{Binding NewRedirectUrl, Converter={StaticResource StringEmptyToVisConverter}}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom row: Schedule and Action button -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Schedule Selector -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Enforcement Schedule" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding ScheduleOptions}" SelectedItem="{Binding SelectedSchedule}" Style="{StaticResource ModernComboBox}" Height="38" />
                        </StackPanel>

                        <!-- Helper hint -->
                        <TextBlock Grid.Column="1" Text="💡 If Redirect is left blank, visitors will see a secure dark-mode block page." FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="16,0,16,10" />

                        <!-- Add Rule Button -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <Button Content="➕ Add Website Rule" Command="{Binding AddRuleCommand}" Style="{StaticResource ModernPrimaryButton}" Height="38" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Active Websites Card -->
            <Border Style="{StaticResource ModernCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Active Blocked Domains" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Rules.Count, StringFormat='Total Domains: {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- ItemsControl -->
                    <ItemsControl ItemsSource="{Binding Rules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Globe Icon -->
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="#162A38" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" Margin="0,0,14,0">
                                            <TextBlock Text="🌐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Domain Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding UrlOrKeyword}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                <Border CornerRadius="4" Padding="6,2" Background="#162A38">
                                                    <TextBlock Text="{Binding ScheduleType}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>

                                            <!-- When Redirect is set -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding RedirectUrl, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                                <TextBlock Text="↪ Redirects to: " FontSize="11" Foreground="{StaticResource AccentPurpleBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding RedirectUrl}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" TextTrimming="CharacterEllipsis" MaxWidth="450" />
                                            </StackPanel>

                                            <!-- Multi-Hop Chained Redirect Display (e.g., nano.gov -> wiki.com -> youtube.com) -->
                                            <Border CornerRadius="4" Padding="8,4" Margin="0,6,0,0" Background="#1D1933" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" HorizontalAlignment="Left"
                                                    Visibility="{Binding IsChainedRedirect, Converter={StaticResource BoolToVisConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔗 Multi-Hop Chained Redirect: " FontSize="11" Foreground="{StaticResource AccentPurpleBrush}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding ChainVisualText}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" />
                                                </StackPanel>
                                            </Border>

                                            <!-- When Direct Block (no redirect) -->
                                            <TextBlock Text="🚫 Direct Block (Enforced by Local HTTPS Engine)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       Visibility="{Binding RedirectUrl, Converter={StaticResource StringEmptyToVisConverter}}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Status Toggle -->
                                        <Button Grid.Column="2"
                                                Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,8,0" Height="32" Padding="8,4" FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
                                                    <Setter Property="Content" Value="Active" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Content" Value="Paused" />
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Delete Button -->
                                        <Button Grid.Column="3"
                                                Content="🗑️ Delete"
                                                Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ModernDangerButton}"
                                                Height="32" Padding="10,4" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state text: now hides when Rules.Count > 0 -->
                    <TextBlock Text="No website rules configured yet. Add a domain above to start filtering."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextAlignment="Center" Margin="0,20,0,10"
                               Visibility="{Binding Rules.Count, Converter={StaticResource InverseBoolToVisConverter}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
